# Leave empty in development: requests go to /api and Vite proxies them to the gateway.
# For a production build served from a different host, point this at the gateway, e.g.
# VITE_API_BASE_URL=http://localhost:8083
VITE_API_BASE_URL=

# The register page only offers an "Admin" role in `npm run dev`.
# Set this to true ONLY if you really want a production build to let people pick their own role.
VITE_ENABLE_ROLE_PICKER=false

# Demo mode: true = no server needed. The app uses a built-in sample backend that keeps data in the browser.
# Used for the GitHub Pages portfolio demo. Leave false (or unset) when you run the real backend.
VITE_DEMO_MODE=false
